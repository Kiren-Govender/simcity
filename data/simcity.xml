            <prop-map prop="item_production_time" field="item_production_time" type="TDateTime" />
          </mapping>
          <selections>
            <select name="FindByName">
              <sql>
                <![CDATA[SELECT * FROM item WHERE item_name = :aname]]>
              </sql>
              <params>
                <param name="aname" pass-by="" sql-param="aname" type="String" />
              </params>
